# 会话签名密钥（HS256）。内置默认值仅限演示，任何非演示用途必须覆盖：
# 留空 = 使用内置演示密钥（不安全，仅开发）
# AUTH_SESSION_SECRET=
# 会话有效期（秒），默认 86400（24 小时）
# AUTH_SESSION_TTL_SECONDS=86400
# 合成账号（JSON 数组）。留空 = 使用内置三个演示账号（student1/student2/teacher1）
# 条目形如 {"username","password","userId","role","name"}，role ∈ student|teacher|admin
# AUTH_SYNTHETIC_ACCOUNTS=[]

# Set explicitly for persistent PostgreSQL mode; unset preserves the old offline demo.
# The process does not automatically read .env; export it in your shell.
# DATABASE_URL=postgresql+psycopg://learning_app:<url-encoded-password>@127.0.0.1:5432/learning_assistant
# APP_ENV=development
# Tests MUST use a disposable local database with a name ending in _test.
# TEST_DATABASE_URL=postgresql+psycopg://learning_app:<url-encoded-password>@127.0.0.1:5432/learning_assistant_test
