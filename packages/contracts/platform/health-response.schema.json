    "status",
    "service",
    "requestId"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "service": {
      "const": "learning-assistant-api"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    }
  },
  "additionalProperties": false
}
