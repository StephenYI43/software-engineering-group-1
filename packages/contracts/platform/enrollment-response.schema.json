{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassEnrollmentResponse",
  "type": "object",
  "required": [
    "enrollmentId",
    "classId",
    "courseId",
    "joinedAt"
  ],
  "properties": {
    "enrollmentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "classId": {
      "type": "string",
      "pattern": "^class_[0-9a-f]{32}$"
    },
    "courseId": {
      "type": "string",
      "pattern": "^course_[0-9a-f]{32}$"
    },
    "joinedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "additionalProperties": false
}
